<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="All Test Suite">
    <test name= "smokeTest" verbose="2" preserve-order="true">
        <groups>
            <run><include name="smoke"/></run>
        </groups>
        <classes><class name="com.learn.maven.GroupingTest"></class></classes>

    </test>
    <test name= "RegressionTest" verbose="2" preserve-order="true">
        <groups>
            <run><include name="regression"/></run>
        </groups>
        <classes><class name="com.learn.maven.GroupingTest"></class></classes>

    </test>
</suite>