<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Selenium Test Suite" parallel="tests" thread-count="3">
    <test name="Title Verification Test with Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.learn.Selenium.CrossBrowserHandling.CrossBrowserTestNgXml"></class>
        </classes>
    </test>
    <test name="Title Verification Test with Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.learn.Selenium.CrossBrowserHandling.CrossBrowserTestNgXml"></class>
        </classes>
    </test>
    <test name="Title Verification Test with firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.learn.Selenium.CrossBrowserHandling.CrossBrowserTestNgXml"></class>
        </classes>
    </test>
</suite>